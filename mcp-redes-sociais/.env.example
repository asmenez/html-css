# ---------- Instagram (API oficial da Meta) ----------
# Conta precisa ser Profissional (Business ou Creator).
# Token de longa duração (60 dias) com as permissões:
#   instagram_business_basic, instagram_business_content_publish
IG_ACCESS_TOKEN=
# ID da conta Instagram. Opcional com graph.instagram.com (usa a própria conta do token).
# Obrigatório com graph.facebook.com.
IG_USER_ID=
# Endereço da API. Normalmente não precisa mexer: o programa descobre pelo token
# (tokens "IG..." usam graph.instagram.com; tokens "EAA..." usam graph.facebook.com).
IG_GRAPH_HOST=
IG_API_VERSION=v23.0

# ---------- TikTok (Content Posting API) ----------
# Crie um app em https://developers.tiktok.com com o produto "Content Posting API"
# e os escopos user.info.basic, video.publish, video.upload e video.list.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Gerados pelo comando `npm run auth:tiktok` (salvos também em data/tokens.json)
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# ---------- Geral ----------
# Pasta onde ficam a fila de agendamentos e os tokens renovados
DATA_DIR=./data
# Intervalo (segundos) em que o servidor verifica posts agendados
SCHEDULER_INTERVAL_SECONDS=60
